# Toastrack — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in the real values.
# Both are safe to expose in the browser bundle (anon key is public by design;
# real security is enforced by Supabase Row Level Security policies).

# Supabase project: https://supabase.com/dashboard/project/ngcsfrhxivipkabsised
NEXT_PUBLIC_SUPABASE_URL=https://ngcsfrhxivipkabsised.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: base path for the static export.
# Defaults to "/toastrack" in production (GitHub Pages project page) and "" in dev.
# Set to "" if deploying to a custom domain or a user/org root page.
# NEXT_PUBLIC_BASE_PATH=/toastrack

# --- Migração pra Sheets/Drive (ver MIGRACAO_SHEETS.md) ---
# server-only: SEM prefixo NEXT_PUBLIC_, nunca deve chegar ao bundle do navegador.
# APPS_SCRIPT_URL termina em /exec (implantação do apps-script/Codigo.gs como Web App).
# APPS_SCRIPT_SHARED_SECRET tem que bater com o SHARED_SECRET colado em Config.gs.
APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
APPS_SCRIPT_SHARED_SECRET=your-shared-secret-here
